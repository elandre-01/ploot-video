    {
      "id": "vo-12",
      "start": 43.35,
      "mediaStart": 44.965,
      "mediaEnd": 46.46,
      "text": "analizan a tu competencia."
    },
    {
      "id": "vo-13",
      "start": 45.536,
      "mediaStart": 46.94,
