    {
      "id": "vo-02e",
      "start": 15.95,
      "mediaStart": 16.57,
      "mediaEnd": 18.66,
      "text": "Mensajes en fr\u00edo que nadie abre."
    },
    {
      "id": "vo-03",
      "start": 18.98,
      "mediaStart": 19.84,
      "mediaEnd": 22.4,
