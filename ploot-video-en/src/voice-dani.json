    },
    {
      "id": "vo-17",
      "start": 59.168,
      "mediaStart": 61.19,
      "mediaEnd": 64.98,
      "text": "Uno. Convertimos el conocimiento de tu equipo en audiencia."
    },
    {
      "id": "vo-18",
      "start": 64.628,
      "mediaStart": 65.47,
      "mediaEnd": 68.38,
